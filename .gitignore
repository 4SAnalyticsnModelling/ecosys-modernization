ecosys-ng/.zig-cache/
ecosys-ng/zig-out/
ecosys-ng/ecosys-ng-bin/
.claude/scheduled_tasks.lock

# Generated, derivable artifacts -- never commit these.
# `__pycache__/` is Python bytecode debris. The two JSON files are large derived
# indexes regenerated from `f77src/` and `ecosys-ng/src/` by
# `ecosys-audit/scripts/f77index.py` and `bindcheck.py` (3.6 MB and 1.6 MB).
# Committing a derived index invites it going stale against the sources it
# describes, which is exactly the failure mode this audit keeps finding in
# hand-maintained records. Dated report artifacts that back a specific claim
# (e.g. `audit/manifest/tracecov-2026-09-21.json`) ARE committed as evidence.
__pycache__/
audit/manifest/f77index.json
audit/manifest/bindcheck-2026-09-21.json

# Local controller locks, delivery intents, session IDs and temporary drafts.
# Immutable tasks/reviews/history and raw scientific evidence are NOT ignored.
audit/workflow/runtime/
archive/pre-swarm-workflow/audit/workflow/runtime/
**/.workflow-publish.lock
audit/workflow/*-next.json
audit/workflow/checkpoint-next.md

# Staged copies of the production deck used by probe/fix runs (~420 files each).
# Their run records (receipts, logs, run-0NN.md) are committed; the decks never are.
audit/runs/*-deck/

# Ottawa qualification swarm (ecosys-ng_ottawa_qualification_execution_plan.md).
# Large binary evidence stays inside this repository but out of Git; its committed
# manifests (sha256, argv, binding) under evidence/manifest/ are the citable record.
evidence/*
!evidence/README.md
!evidence/manifest/
!evidence/schema/
# Swarm runtime: locks and per-dispatch scratch are local. Tasks, results,
# failure packets and archive are durable evidence and ARE committed.
.agent/locks/*
!.agent/locks/.gitkeep
.agent/runtime/

# Controller console transcript (tee'd by the operator; not agent output).
audit/runs/swarm-controller-*.log
