{
  "schema_version": 2,
  "authority": ".agent/protocol.md",
  "rule": "argv are templates; verify source/toolchain before execution. Never treat a registry entry as a passed check.",
  "commands": {
    "pickup": [
      "./scripts/project.sh",
      "pickup"
    ],
    "logged": [
      "./scripts/project.sh",
      "exec",
      "--out",
      "audit/runs/<unique>",
      "--cwd",
      "<repo-relative>",
      "--",
      "<argv>"
    ],
    "code_batch": [
      "./scripts/project.sh",
      "code",
      "--requests",
      ".tmp/reads.json"
    ],
    "codemod_preview": [
      "./scripts/project.sh",
      "codemod",
      "--spec",
      ".tmp/edits.json"
    ],
    "zig_build": [
      "zig",
      "build",
      "-Doptimize=<Debug|ReleaseSafe|ReleaseFast>",
      "--cache-dir",
      ".zig-cache"
    ],
    "zig_tests": [
      "zig",
      "build",
      "test",
      "--cache-dir",
      ".zig-cache"
    ],
    "zig_filtered": [
      "zig",
      "test",
      "src/module_index.zig",
      "--cache-dir",
      ".zig-cache",
      "--test-filter",
      "<name>"
    ],
    "python_tests": [
      "uv",
      "run",
      "--with",
      "pytest",
      "pytest",
      "ecosys-audit/tests",
      "-q"
    ],
    "f77_index": [
      "python3",
      "-B",
      "ecosys-audit/scripts/f77index.py",
      "--root",
      ".",
      "--out",
      "audit/manifest/f77index.json"
    ],
    "f77_outline": [
      "python3",
      "-B",
      "ecosys-audit/scripts/f77query.py",
      "outline",
      "<file.f>",
      "--depth",
      "1"
    ],
    "oracle_driver": [
      "python3",
      "-B",
      "ecosys-audit/scripts/kernelgen.py",
      "<routine>",
      "--root",
      ".",
      "--scope",
      "referenced"
    ],
    "strict_run": [
      "python3",
      "-B",
      "ecosys-audit/scripts/run_ottawa.py",
      "--mode",
      "strict",
      "--exe",
      "<repo-local-exe>",
      "--build-mode",
      "ReleaseFast",
      "--run-id",
      "<unique>",
      "--build-receipt",
      "<matching-build-receipt.json>"
    ],
    "restart_diagnostic": [
      "python3",
      "-B",
      "ecosys-audit/scripts/run_ottawa.py",
      "--mode",
      "strict",
      "--exe",
      "<repo-local-exe>",
      "--build-mode",
      "ReleaseFast",
      "--restart-from",
      "<parent-run>:<hour>"
    ],
    "finish": [
      "./scripts/project.sh",
      "completion.py"
    ]
  },
  "cwd": {
    "zig_build": "ecosys-ng",
    "zig_tests": "ecosys-ng",
    "zig_filtered": "ecosys-ng",
    "other": "repository root"
  },
  "limitations": "Filtered module tests do not cover the executable test root. Legacy compile/run argv must be discovered for the actual host. No campaign or science gate is passed by this registry."
}
